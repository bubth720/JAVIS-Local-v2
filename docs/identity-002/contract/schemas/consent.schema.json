{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:identity:001b:consent",
  "title": "consent",
  "type": "object",
  "properties": {
    "version": {
      "const": "jarvis.identity/1"
    },
    "schema_revision": {
      "const": "001B.1-candidate"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "const": "consent"
    },
    "subject_ref": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "content_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "enum": [
        "GRANTED",
        "REVOKED"
      ],
      "maxLength": 64
    },
    "purpose": {
      "const": "PERSONAL_STYLE_SESSION"
    },
    "confirmation_ref": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "consent_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "schema_revision",
    "id",
    "revision",
    "kind",
    "subject_ref",
    "content_ref",
    "decision",
    "purpose",
    "confirmation_ref",
    "consent_revision",
    "created_ms",
    "expires_ms"
  ],
  "additionalProperties": false
}
