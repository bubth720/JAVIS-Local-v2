{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:identity:001b:jarvis-preference",
  "title": "jarvis-preference",
  "type": "object",
  "properties": {
    "version": {
      "const": "jarvis.identity/1"
    },
    "schema_revision": {
      "const": "001B.1-candidate"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "const": "jarvis-preference"
    },
    "category": {
      "const": "SIMULATED"
    },
    "key": {
      "type": "string",
      "enum": [
        "assertiveness",
        "warmth",
        "verbosity",
        "humour",
        "critical_thinking",
        "addressing"
      ],
      "maxLength": 64
    },
    "value": {
      "type": "string",
      "enum": [
        "ASSERTIVE",
        "BALANCED",
        "CALM",
        "CONCISE",
        "DETAILED",
        "EVIDENCE_FIRST",
        "LIGHT",
        "NEUTRAL",
        "OFF",
        "TU",
        "VOUS",
        "WARM"
      ],
      "maxLength": 64
    },
    "storage": {
      "const": "TECHNICAL_CONFIG"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "PROGRAMMED",
        "USER_APPROVED"
      ],
      "maxLength": 64
    },
    "created_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "decision_ref": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "maxLength": 36
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "schema_revision",
    "id",
    "revision",
    "kind",
    "category",
    "key",
    "value",
    "storage",
    "provenance",
    "created_ms",
    "expires_ms",
    "decision_ref"
  ],
  "additionalProperties": false
}
