{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:identity:001b:personal-preference",
  "title": "personal-preference",
  "type": "object",
  "properties": {
    "version": {
      "const": "jarvis.identity/1"
    },
    "schema_revision": {
      "const": "001B.1-candidate"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "const": "personal-preference"
    },
    "category": {
      "const": "PERSONAL_STYLE"
    },
    "subject_ref": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "key": {
      "type": "string",
      "enum": [
        "assertiveness",
        "warmth",
        "verbosity",
        "humour",
        "critical_thinking",
        "addressing"
      ],
      "maxLength": 64
    },
    "value": {
      "type": "string",
      "enum": [
        "ASSERTIVE",
        "BALANCED",
        "CALM",
        "CONCISE",
        "DETAILED",
        "EVIDENCE_FIRST",
        "LIGHT",
        "NEUTRAL",
        "OFF",
        "TU",
        "VOUS",
        "WARM"
      ],
      "maxLength": 64
    },
    "storage": {
      "const": "EPHEMERAL_ONLY"
    },
    "created_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "schema_revision",
    "id",
    "revision",
    "kind",
    "category",
    "subject_ref",
    "key",
    "value",
    "storage",
    "created_ms",
    "expires_ms"
  ],
  "additionalProperties": false
}
