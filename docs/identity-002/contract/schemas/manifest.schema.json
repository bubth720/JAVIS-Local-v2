{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:identity:001b:manifest",
  "title": "manifest",
  "type": "object",
  "properties": {
    "version": {
      "const": "jarvis.identity/1"
    },
    "schema_revision": {
      "const": "001B.1-candidate"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "const": "manifest"
    },
    "name": {
      "const": "JARVIS"
    },
    "profile": {
      "const": "B"
    },
    "locale": {
      "type": "string",
      "enum": [
        "fr-FR"
      ],
      "maxLength": 64
    },
    "constitution_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "composer_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "styles": {
      "type": "object",
      "properties": {
        "assertiveness": {
          "type": "string",
          "enum": [
            "ASSERTIVE",
            "CALM"
          ],
          "maxLength": 64
        },
        "warmth": {
          "type": "string",
          "enum": [
            "WARM",
            "NEUTRAL"
          ],
          "maxLength": 64
        },
        "verbosity": {
          "type": "string",
          "enum": [
            "CONCISE",
            "BALANCED",
            "DETAILED"
          ],
          "maxLength": 64
        },
        "humour": {
          "type": "string",
          "enum": [
            "OFF",
            "LIGHT"
          ],
          "maxLength": 64
        },
        "critical_thinking": {
          "type": "string",
          "enum": [
            "EVIDENCE_FIRST"
          ],
          "maxLength": 64
        },
        "addressing": {
          "type": "string",
          "enum": [
            "VOUS",
            "TU"
          ],
          "maxLength": 64
        }
      },
      "required": [
        "assertiveness",
        "warmth",
        "verbosity",
        "humour",
        "critical_thinking",
        "addressing"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "schema_revision",
    "id",
    "revision",
    "kind",
    "name",
    "profile",
    "locale",
    "constitution_sha256",
    "composer_revision",
    "styles"
  ],
  "additionalProperties": false
}
