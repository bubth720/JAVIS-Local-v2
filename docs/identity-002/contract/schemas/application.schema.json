{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:identity:001b:application",
  "title": "application",
  "type": "object",
  "properties": {
    "version": {
      "const": "jarvis.identity/1"
    },
    "schema_revision": {
      "const": "001B.1-candidate"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "const": "application"
    },
    "proposal_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "decision_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "STAGED",
        "APPLIED",
        "FAILED",
        "ROLLED_BACK"
      ],
      "maxLength": 64
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "previous_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_sha256": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rollback_ref": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        {
          "type": "null"
        }
      ]
    },
    "created_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "schema_revision",
    "id",
    "revision",
    "kind",
    "proposal_ref",
    "decision_ref",
    "state",
    "transaction_id",
    "previous_sha256",
    "result_sha256",
    "rollback_ref",
    "created_ms"
  ],
  "additionalProperties": false
}
