@@ -0,0 +1,33 @@
+package com.stark.jarvislocal
+
+import com.stark.jarvislocal.identity.IdentityComposer
+import dev.ffmpegkit.llama.LlamaMeasured
+import dev.ffmpegkit.llama.MeasuredReceipt
+import dev.ffmpegkit.llama.LlamaModel
+import java.security.MessageDigest
+
+internal data class ExactArtifact(val modelSha256: String, val templateSha256: String) {
+    init { require(listOf(modelSha256, templateSha256).all { it.matches(Regex("[a-f0-9]{64}")) }) }
+}
+
+internal interface ExactLlamaBackend : LlamaBackend {
+    val exactEnabled: Boolean
+    suspend fun completeExact(model: Any, request: InferenceRequest, ownerEpoch: String,
+        lease: Long, finalAdmission: () -> Unit): String
+}
+
+internal fun exactBinding(request: InferenceRequest, owner: String, lease: Long): String =
+    MessageDigest.getInstance("SHA-256").digest(
+        ("core.exact/1-proposed\n$owner\n$lease\n" + IdentityComposer.requestDigest(request))
+            .toByteArray(Charsets.UTF_8)).joinToString("") { "%02x".format(it.toInt() and 255) }
+
+internal fun checkExactReceipt(receipt: MeasuredReceipt, expectedModel: String,
+    expectedBinding: String, request: InferenceRequest, expectedTemplate: String) {
+    check(receipt.revision == LlamaMeasured.REVISION && receipt.modelSha256 == expectedModel &&
+        receipt.bindingSha256 == expectedBinding && receipt.templateSha256 == expectedTemplate && receipt.loadGeneration > 0) { "MEASUREMENT_MISMATCH" }
+    check(receipt.outputReserve == request.limits.maxTokens && receipt.marginReserve == 128 &&
+        receipt.inputTokens > 0 && receipt.admittedContext <= request.limits.contextSize &&
+        receipt.inputTokens + receipt.outputReserve.toLong() + receipt.marginReserve <= receipt.admittedContext) { "CONTEXT_EXCEEDED" }
+    for (hash in listOf(receipt.templateSha256, receipt.renderedSha256, receipt.tokenIdsSha256))
+        check(hash.matches(Regex("[a-f0-9]{64}"))) { "INVALID_RECEIPT" }
+}
