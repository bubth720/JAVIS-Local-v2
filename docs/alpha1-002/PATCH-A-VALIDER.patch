diff --git a/upstream/library/src/main/jni/measured.inc b/upstream/library/src/main/jni/measured.inc
new file mode 100644
--- /dev/null
+++ b/upstream/library/src/main/jni/measured.inc
@@ -0,0 +1,238 @@
+// Proposed internal implementation, included after the historical helpers.
+// No model is loaded, context created, KV cleared or decode run by prepare.
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <cstring>
+namespace {
+using Clock = std::chrono::steady_clock;
+struct Prepared {
+    std::string ticket, binding;
+    std::vector<llama_token> tokens;
+    uint64_t generation, kvEpoch;
+    uint32_t capacity;
+    int output, margin;
+    Clock::time_point expires;
+    ~Prepared() {
+        volatile llama_token *p = tokens.data();
+        for (size_t i = 0; i < tokens.size(); ++i) p[i] = 0;
+    }
+};
+struct LiveModel {
+    uint64_t generation;
+    std::thread::id worker;
+    std::unique_ptr<Prepared> pending;
+    uint64_t kvEpoch = 0;
+};
+std::mutex measuredMutex;
+std::map<LlamaCtx *, LiveModel> liveModels;
+uint64_t nextGeneration = 1;
+void require_measured(bool ok, const char *why) {
+    if (!ok) throw std::runtime_error(why);
+}
+LlamaCtx *owned(jlong handle, bool allowPending = false) {
+    auto *h = reinterpret_cast<LlamaCtx *>(handle);
+    auto it = liveModels.find(h);
+    require_measured(it != liveModels.end(), "STALE_MODEL");
+    require_measured(it->second.worker == std::this_thread::get_id(), "WRONG_WORKER");
+    require_measured(allowPending || !it->second.pending, "PREPARED_BUSY");
+    return h;
+}
+void throw_measured(JNIEnv *env, const char *why) {
+    if (!env->ExceptionCheck()) {
+        jclass c = env->FindClass("java/lang/IllegalStateException");
+        if (c) { env->ThrowNew(c, why); env->DeleteLocalRef(c); }
+    }
+}
+bool strict_utf8(const std::string &s) {
+    size_t i = 0;
+    while (i < s.size()) {
+        uint8_t a = static_cast<uint8_t>(s[i++]);
+        if (!a) return false; // Deliberate NUL refusal: template messages use C strings.
+        if (a < 0x80) continue;
+        int n; uint32_t cp, min;
+        if (a >= 0xc2 && a <= 0xdf) { n=1; cp=a&31; min=0x80; }
+        else if (a >= 0xe0 && a <= 0xef) { n=2; cp=a&15; min=0x800; }
+        else if (a >= 0xf0 && a <= 0xf4) { n=3; cp=a&7; min=0x10000; }
+        else return false;
+        if (s.size()-i < static_cast<size_t>(n)) return false;
+        while (n--) { uint8_t b=static_cast<uint8_t>(s[i++]);
+            if ((b&0xc0)!=0x80) return false;
+            cp=(cp<<6)|(b&63);
+        }
+        if (cp < min || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff)) return false;
+    }
+    return true;
+}
+std::string bytes(JNIEnv *env, jbyteArray input, size_t maximum) {
+    require_measured(input != nullptr, "INVALID_BYTES");
+    jsize n=env->GetArrayLength(input);
+    require_measured(n >= 0 && static_cast<size_t>(n) <= maximum, "INPUT_LIMIT");
+    std::string out(static_cast<size_t>(n), '\0');
+    if (n) env->GetByteArrayRegion(input,0,n,reinterpret_cast<jbyte *>(out.data()));
+    require_measured(!env->ExceptionCheck(), "JNI_COPY_FAILED");
+    require_measured(strict_utf8(out), "INVALID_UTF8_OR_NUL");
+    return out;
+}
+jbyteArray to_bytes(JNIEnv *env, const std::string &s) {
+    require_measured(s.size() <= static_cast<size_t>(std::numeric_limits<jsize>::max()), "OUTPUT_LIMIT");
+    jbyteArray out=env->NewByteArray(static_cast<jsize>(s.size()));
+    require_measured(out != nullptr, "JNI_ALLOCATION_FAILED");
+    if (!s.empty()) env->SetByteArrayRegion(out,0,static_cast<jsize>(s.size()),
+        reinterpret_cast<const jbyte *>(s.data()));
+    require_measured(!env->ExceptionCheck(), "JNI_COPY_FAILED");
+    return out;
+}
+std::string render_strict(const llama_model *m, const std::string &system,
+                          const std::string &user, std::string &templateText) {
+    const char *t=llama_model_chat_template(m,nullptr);
+    require_measured(t && *t, "TEMPLATE_UNSUPPORTED");
+    size_t tn=strnlen(t,65537);
+    require_measured(tn <= 65536, "TEMPLATE_LIMIT");
+    templateText.assign(t,tn);
+    require_measured(strict_utf8(templateText), "INVALID_TEMPLATE_ENCODING");
+    // SYSTEM is never concatenated into user on error. The two roles are distinct.
+    std::vector<llama_chat_message> messages;
+    if (!system.empty()) messages.push_back({"system",system.c_str()});
+    messages.push_back({"user",user.c_str()});
+    std::vector<char> buf(65536);
+    int32_t n=llama_chat_apply_template(t,messages.data(),messages.size(),true,buf.data(),buf.size());
+    require_measured(n > 0 && n <= static_cast<int32_t>(buf.size()), "TEMPLATE_UNSUPPORTED_OR_LIMIT");
+    std::string rendered(buf.data(),n);
+    require_measured(strict_utf8(rendered), "INVALID_RENDER_ENCODING");
+    return rendered;
+}
+std::vector<llama_token> tokenize_strict(const llama_vocab *v, const std::string &s) {
+    int32_t n=llama_tokenize(v,s.data(),static_cast<int32_t>(s.size()),nullptr,0,true,true);
+    require_measured(n < 0 && n != std::numeric_limits<int32_t>::min(), "TOKENIZER_UNAVAILABLE");
+    require_measured(-n <= 65536, "TOKEN_LIMIT");
+    std::vector<llama_token> out(static_cast<size_t>(-n));
+    int32_t actual=llama_tokenize(v,s.data(),static_cast<int32_t>(s.size()),out.data(),out.size(),true,true);
+    require_measured(actual == -n, "TOKENIZER_INCONSISTENT");
+    return out;
+}
+void exact_budget(uint64_t input, int output, int margin, uint32_t capacity) {
+    require_measured(input > 0 && output > 0 && output <= 256 && margin == 128, "INVALID_BUDGET");
+    // Subtractions after bounds checks: overflow cannot manufacture admission.
+    require_measured(input <= capacity && static_cast<uint64_t>(output) <= capacity-input &&
+        static_cast<uint64_t>(margin) <= capacity-input-static_cast<uint64_t>(output), "CONTEXT_EXCEEDED");
+}
+std::string piece_strict(const llama_vocab *v,llama_token token) {
+    std::vector<char> b(256);
+    int n=llama_token_to_piece(v,token,b.data(),b.size(),0,true);
+    if (n < 0) {
+        require_measured(n != std::numeric_limits<int>::min() && -n <= 65536,"PIECE_LIMIT");
+        b.resize(-n); n=llama_token_to_piece(v,token,b.data(),b.size(),0,true);
+    }
+    require_measured(n >= 0 && static_cast<size_t>(n) <= b.size(),"PIECE_FAILED");
+    return std::string(b.data(),n);
+}
+} // namespace
+
+extern "C" JNIEXPORT jobjectArray JNICALL
+Java_dev_ffmpegkit_llama_LlamaJNI_nativePrepareMeasured(JNIEnv *env,jobject,jlong handle,
+    jbyteArray sys,jbyteArray prompt,jbyteArray binding,jbyteArray ticket,
+    jint requested,jint admitted,jint output,jint margin,jint ttlMs) {
+    try {
+        std::lock_guard<std::mutex> guard(measuredMutex);
+        LlamaCtx *h=owned(handle);
+        require_measured(requested > 0 && requested <= 2048 && admitted > 0 && admitted <= 2048 &&
+            ttlMs > 0 && ttlMs <= 5000,"INVALID_LIMITS");
+        auto p=std::make_unique<Prepared>();
+        p->binding=bytes(env,binding,64); p->ticket=bytes(env,ticket,64);
+        auto isHex=[](const std::string &s) { return s.size()==64 && std::all_of(s.begin(),s.end(),
+            [](char c) { return (c>='0' && c<='9') || (c>='a' && c<='f'); }); };
+        require_measured(isHex(p->binding) && isHex(p->ticket),"INVALID_BINDING");
+        std::string t;
+        std::string rendered=render_strict(h->model,bytes(env,sys,8192),bytes(env,prompt,16384),t);
+        p->tokens=tokenize_strict(llama_model_get_vocab(h->model),rendered);
+        p->capacity=std::min({static_cast<uint32_t>(requested),static_cast<uint32_t>(admitted),llama_n_ctx(h->ctx),llama_n_ctx_seq(h->ctx)});
+        exact_budget(p->tokens.size(),output,margin,p->capacity);
+        p->generation=liveModels.at(h).generation;
+        p->kvEpoch=liveModels.at(h).kvEpoch;
+        p->output=output; p->margin=margin; p->expires=Clock::now()+std::chrono::milliseconds(ttlMs);
+        std::string meta="1,"+std::to_string(p->generation)+","+std::to_string(p->tokens.size())+","+
+            std::to_string(std::min(llama_n_ctx(h->ctx),llama_n_ctx_seq(h->ctx)))+","+std::to_string(p->capacity)+","+std::to_string(p->kvEpoch);
+        // IDs copied only to the private wrapper to hash, never accepted back from Kotlin.
+        std::string packed; packed.reserve(p->tokens.size()*4);
+        for (llama_token id:p->tokens) for (int i=0;i<4;++i) packed.push_back(static_cast<char>(static_cast<uint32_t>(id)>>(i*8)));
+        jclass byteArrayClass=env->FindClass("[B");
+        require_measured(byteArrayClass != nullptr,"JNI_CLASS_FAILED");
+        jobjectArray result=env->NewObjectArray(4,byteArrayClass,nullptr);
+        env->DeleteLocalRef(byteArrayClass);
+        require_measured(result != nullptr,"JNI_ALLOCATION_FAILED");
+        std::string parts[4]={meta,t,rendered,packed};
+        for (int i=0;i<4;++i) { jbyteArray a=to_bytes(env,parts[i]); env->SetObjectArrayElement(result,i,a); env->DeleteLocalRef(a); }
+        require_measured(!env->ExceptionCheck(),"JNI_COPY_FAILED");
+        liveModels.at(h).pending=std::move(p);
+        return result;
+    } catch (const std::exception &e) { throw_measured(env,e.what()); }
+      catch (...) { throw_measured(env,"NATIVE_PREPARE_FAILED"); }
+    return nullptr;
+}
+
+extern "C" JNIEXPORT jbyteArray JNICALL
+Java_dev_ffmpegkit_llama_LlamaJNI_nativeConsumeMeasured(JNIEnv *env,jobject,jlong handle,
+    jlong generation,jbyteArray ticket,jbyteArray binding,
+    jfloat temp,jfloat topP,jint topK,jint seed) {
+    try {
+        std::lock_guard<std::mutex> guard(measuredMutex);
+        LlamaCtx *h=owned(handle,true);
+        // Remove BEFORE validation: every consumption attempt burns this model's ticket.
+        auto p=std::move(liveModels.at(h).pending);
+        require_measured(p != nullptr,"TICKET_MISSING");
+        require_measured(p->generation == static_cast<uint64_t>(generation) &&
+            p->generation == liveModels.at(h).generation,"STALE_MODEL");
+        require_measured(p->ticket==bytes(env,ticket,64) && p->binding==bytes(env,binding,64),"TICKET_MISMATCH");
+        require_measured(Clock::now() < p->expires,"EXPIRED");
+        exact_budget(p->tokens.size(),p->output,p->margin,std::min({p->capacity,llama_n_ctx(h->ctx),llama_n_ctx_seq(h->ctx)}));
+        require_measured(temp >= 0 && temp <= 2 && topP > 0 && topP <= 1 && topK > 0,"INVALID_SAMPLING");
+        auto *v=llama_model_get_vocab(h->model);
+        std::unique_ptr<llama_sampler,decltype(&llama_sampler_free)> sampler(
+            make_sampler(temp,topP,topK,seed),llama_sampler_free);
+        require_measured(sampler != nullptr,"SAMPLER_FAILED");
+        require_measured(p->kvEpoch == liveModels.at(h).kvEpoch,"STALE_KV");
+        require_measured(liveModels.at(h).kvEpoch < std::numeric_limits<uint64_t>::max(),"KV_EPOCH_EXHAUSTED");
+        ++liveModels.at(h).kvEpoch;
+        // Only consume changes KV. Decode the retained IDs, in bounded batches.
+        llama_memory_clear(llama_get_memory(h->ctx),true);
+        size_t off=0;
+        uint32_t batchSize=llama_n_batch(h->ctx);
+        require_measured(batchSize>0,"INVALID_BATCH");
+        while (off < p->tokens.size()) {
+            int32_t n=static_cast<int32_t>(std::min<size_t>(batchSize,p->tokens.size()-off));
+            require_measured(llama_decode(h->ctx,llama_batch_get_one(p->tokens.data()+off,n))==0,"PREFILL_FAILED");
+            off+=n;
+        }
+        std::string out;
+        for (int i=0;i<p->output;++i) {
+            llama_token id=llama_sampler_sample(sampler.get(),h->ctx,-1);
+            if (llama_vocab_is_eog(v,id)) break;
+            llama_sampler_accept(sampler.get(),id);
+            std::string piece=piece_strict(v,id);
+            require_measured(out.size()+piece.size() <= 1048576,"OUTPUT_LIMIT"); out+=piece;
+            require_measured(llama_decode(h->ctx,llama_batch_get_one(&id,1))==0,"GENERATE_FAILED");
+        }
+        require_measured(strict_utf8(out),"INCOMPLETE_OUTPUT_UTF8");
+        return to_bytes(env,out);
+    } catch (const std::exception &e) { throw_measured(env,e.what()); }
+      catch (...) { throw_measured(env,"NATIVE_CONSUME_FAILED"); }
+    return nullptr;
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_dev_ffmpegkit_llama_LlamaJNI_nativeDiscardMeasured(JNIEnv *env,jobject,jlong handle,jbyteArray ticket) {
+    try {
+        std::lock_guard<std::mutex> guard(measuredMutex);
+        LlamaCtx *h=owned(handle,true);
+        auto &p=liveModels.at(h).pending;
+        if (p) { require_measured(p->ticket==bytes(env,ticket,64),"TICKET_MISMATCH"); p.reset(); }
+    } catch (const std::exception &e) { throw_measured(env,e.what()); }
+      catch (...) { throw_measured(env,"NATIVE_DISCARD_FAILED"); }
+}
