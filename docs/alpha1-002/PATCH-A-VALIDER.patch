--- /dev/null
+++ b/upstream/library/src/main/kotlin/dev/ffmpegkit/llama/LlamaMeasured.kt
@@ -0,0 +1,143 @@
+package dev.ffmpegkit.llama
+
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.nio.ByteBuffer
+import java.nio.CharBuffer
+import java.nio.charset.CodingErrorAction
+import java.security.MessageDigest
+import java.security.SecureRandom
+import java.util.concurrent.Executors
+import java.util.concurrent.Callable
+import kotlinx.coroutines.asCoroutineDispatcher
+import kotlinx.coroutines.withContext
+
+/** One library worker, shared by historical calls and the proposed measured path. */
+internal object LlamaOwner {
+    @Volatile private var thread: Thread? = null
+    private val executor = Executors.newSingleThreadExecutor { task ->
+        Thread(task, "jarvis-llama-owner").also { it.isDaemon = true; thread = it }
+    }
+    val dispatcher = executor.asCoroutineDispatcher()
+    fun <T> blocking(block: () -> T): T = if (Thread.currentThread() === thread) block()
+        else executor.submit(Callable { block() }).get()
+    fun checkWorker() = check(Thread.currentThread() === thread) { "WRONG_WORKER" }
+}
+
+/** Information for a trusted host gate. Not an inference permit or an unload receipt. */
+class MeasuredReceipt internal constructor(
+    val revision: String, val modelSha256: String, val loadGeneration: Long,
+    val templateSha256: String, val renderedSha256: String, val tokenIdsSha256: String,
+    val bindingSha256: String, val kvEpoch: Long, val inputTokens: Long, val loadedContext: Long,
+    val admittedContext: Long, val outputReserve: Int, val marginReserve: Int,
+)
+
+class MeasuredTransactionFailure(val nativeStateKnown: Boolean, cause: Throwable) :
+    IllegalStateException("Measured transaction refused; model remains resident", cause)
+
+/** Proposed public API. Ticket and IDs never leave this scoped wrapper. */
+object LlamaMeasured {
+    const val REVISION = "core.identity.measure/1-proposed"
+    private fun sha(data: ByteArray): String = MessageDigest.getInstance("SHA-256")
+        .digest(data).joinToString("") { "%02x".format(it.toInt() and 255) }
+    private fun utf8(value: String): ByteArray {
+        require('\u0000' !in value) { "NUL_UNSUPPORTED" }
+        val b = Charsets.UTF_8.newEncoder().onMalformedInput(CodingErrorAction.REPORT)
+            .onUnmappableCharacter(CodingErrorAction.REPORT).encode(CharBuffer.wrap(value))
+        return ByteArray(b.remaining()).also { b.get(it) }
+    }
+    private fun decode(value: ByteArray): String = Charsets.UTF_8.newDecoder()
+        .onMalformedInput(CodingErrorAction.REPORT).onUnmappableCharacter(CodingErrorAction.REPORT)
+        .decode(ByteBuffer.wrap(value)).toString()
+
+    /** Freeze a private, read-only copy. Original model is never changed or deleted.
+     * Expected digest MUST come from a separately approved artifact manifest.
+     * No automatic model download. Native load still allocates only one model/context.
+     */
+    suspend fun loadFrozen(modelPath: String, config: LlamaConfig, expectedSha256: String): LlamaModel =
+        withContext(LlamaOwner.dispatcher) {
+            require(expectedSha256.matches(Regex("[a-f0-9]{64}"))) { "MODEL_HASH_REQUIRED" }
+            require(config.contextSize in 1..2048) { "INVALID_CONTEXT" }
+            val source = File(modelPath)
+            require(source.isFile && source.length() > 0) { "MODEL_UNAVAILABLE" }
+            val directory = requireNotNull(source.parentFile)
+            require(directory.usableSpace > source.length() &&
+                directory.usableSpace - source.length() >= 16L * 1024 * 1024) { "SNAPSHOT_DISK_UNAVAILABLE" }
+            val frozen = File.createTempFile("jarvis-measured-", ".gguf", directory)
+            var transferred = false
+            try {
+                val digest = MessageDigest.getInstance("SHA-256")
+                FileInputStream(source).use { input -> FileOutputStream(frozen).use { output ->
+                    val buffer = ByteArray(512 * 1024)
+                    try { while (true) { val n = input.read(buffer); if (n < 0) break
+                        if (n > 0) { output.write(buffer, 0, n); digest.update(buffer, 0, n) }
+                    } } finally { buffer.fill(0) }
+                    output.fd.sync()
+                } }
+                val actual = digest.digest().joinToString("") { "%02x".format(it.toInt() and 255) }
+                check(actual == expectedSha256) { "MODEL_HASH_MISMATCH" }
+                check(frozen.setReadOnly()) { "MODEL_FREEZE_FAILED" }
+                val h = LlamaJNI.nativeLoadModel(frozen.absolutePath, config.contextSize, config.threads, config.gpuLayers)
+                check(h != 0L) { "MODEL_LOAD_FAILED" }
+                // No throwable operation between successful native allocation and handle transfer.
+                val model = try { LlamaModel(h, config, frozen, actual) }
+                catch (failure: Throwable) {
+                    // Failure of this release propagates; host must retain admission/quarantine.
+                    LlamaJNI.nativeReleaseModel(h)
+                    throw failure
+                }
+                transferred = true
+                model
+            } finally {
+                if (!transferred && frozen.exists()) check(frozen.delete()) { "SNAPSHOT_CLEANUP_FAILED" }
+            }
+        }
+
+    /** No suspension or arbitrary callback between native prepare and consume.
+     * finalAdmission runs on the owner worker: trusted host validation only, no JNI/reentrancy.
+     */
+    suspend fun complete(model: LlamaModel, system: String, prompt: String, bindingSha256: String,
+        requestedContext: Int, admittedContext: Int, outputReserve: Int,
+        finalAdmission: (MeasuredReceipt) -> Unit): String = withContext(LlamaOwner.dispatcher) {
+        LlamaOwner.checkWorker()
+        check(model.frozenSha256 != null && model.frozenFile?.isFile == true) { "FROZEN_MODEL_REQUIRED" }
+        require(bindingSha256.matches(Regex("[a-f0-9]{64}"))) { "INVALID_BINDING" }
+        val handle = model.requireHandle()
+        val random = ByteArray(32).also { SecureRandom().nextBytes(it) }
+        val ticket = random.joinToString("") { "%02x".format(it.toInt() and 255) }.toByteArray(Charsets.US_ASCII)
+        random.fill(0)
+        val binding = bindingSha256.toByteArray(Charsets.US_ASCII)
+        val systemBytes = utf8(system); val promptBytes = utf8(prompt)
+        var parts: Array<ByteArray>? = null
+        var consumeEntered = false
+        try {
+            parts = LlamaJNI.nativePrepareMeasured(handle, systemBytes, promptBytes, binding, ticket,
+                requestedContext, admittedContext, outputReserve, 128, 5000)
+            check(parts.size == 4) { "INVALID_RECEIPT" }
+            val metadata = decode(parts[0]).split(',').map(String::toLong)
+            check(metadata.size == 6 && metadata[0] == 1L && metadata[1] > 0 && metadata[2] > 0 && metadata[5] >= 0 &&
+                parts[3].size.toLong() == metadata[2] * 4L) { "INVALID_RECEIPT" }
+            val receipt = MeasuredReceipt(REVISION, requireNotNull(model.frozenSha256), metadata[1],
+                sha(parts[1]), sha(parts[2]), sha(parts[3]), bindingSha256, metadata[5],
+                metadata[2], metadata[3], metadata[4], outputReserve, 128)
+            check(receipt.admittedContext == minOf(requestedContext.toLong(), admittedContext.toLong(), receipt.loadedContext))
+            check(receipt.inputTokens + outputReserve.toLong() + 128L <= receipt.admittedContext) { "CONTEXT_EXCEEDED" }
+            finalAdmission(receipt) // Linearization point for CORE; revocation afterwards drains/rejects output.
+            val c = model.config
+            consumeEntered = true
+            val answer = LlamaJNI.nativeConsumeMeasured(handle, receipt.loadGeneration, ticket, binding,
+                c.temperature, c.topP, c.topK, c.seed)
+            try { decode(answer) } finally { answer.fill(0) }
+        } catch (failure: Throwable) {
+            throw MeasuredTransactionFailure(nativeStateKnown = !consumeEntered, cause = failure)
+        } finally {
+            try { LlamaJNI.nativeDiscardMeasured(handle, ticket) }
+            catch (cleanup: Throwable) { throw MeasuredTransactionFailure(nativeStateKnown = false, cause = cleanup) }
+            finally {
+                ticket.fill(0); binding.fill(0); systemBytes.fill(0); promptBytes.fill(0)
+                parts?.forEach { it.fill(0) }
+            }
+        }
+    }
+}
