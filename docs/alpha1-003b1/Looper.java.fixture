// JVM test double ONLY. Never packaged in an AAR/APK or installed on Android.
package android.os;
public final class Looper {
    private static final Looper MAIN = new Looper();
    private static Thread mainThread;
    public static void markMainThreadForTest() { mainThread = Thread.currentThread(); }
    public static Looper getMainLooper() { return MAIN; }
    public static Looper myLooper() { return Thread.currentThread() == mainThread ? MAIN : null; }
}
